            "value" : "Một chương trình trong Terminal này muốn thay nội dung bảng nhớ tạm bằng: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此终端中的程序想要将剪贴板内容替换为：%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此終端機中的程式想要將剪貼板內容替換為：%@"
          }
        }
      }
    },
    "A program to run instead of the shell, with its arguments. Leave empty for the default shell." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامج يُشغَّل بدلاً من الصدفة، مع وسائطه. اتركه فارغاً لاستخدام الصدفة الافتراضية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Programm mit Argumenten, das anstelle der Shell ausgeführt wird. Leer lassen für die Standard-Shell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A program to run instead of the shell, with its arguments. Leave empty for the default shell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programa con sus argumentos que se ejecutará en lugar del shell. Déjelo vacío para usar el shell predeterminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programme et ses arguments à exécuter à la place du shell. Laissez vide pour le shell par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programma con i suoi argomenti da eseguire al posto della shell. Lascia vuoto per la shell predefinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェルの代わりに実行するプログラムとその引数。空のままにするとデフォルトのシェルを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 대신 실행할 프로그램과 인수입니다. 비워 두면 기본 셸을 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um programa com seus argumentos para executar no lugar do shell. Deixe em branco para usar o shell padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Программа с аргументами, которая запустится вместо оболочки. Оставьте пустым, чтобы использовать оболочку по умолчанию."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chương trình chạy thay cho shell, kèm các đối số. Để trống để dùng shell mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替 shell 运行的程序及其参数。留空则使用默认 shell。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替 shell 執行的程式及其引數。留空則使用預設 shell。"
          }
        }
      }
    },
    "A shortcut that is off hands its key to the program running in the terminal. Escape always reaches the terminal." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاختصار المُعطَّل يُمرِّر مفتاحه إلى البرنامج العامل في الطرفية. ويصل مفتاح Escape إلى الطرفية دائماً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ausgeschaltetes Tastenkürzel gibt seine Taste an das Programm im Terminal weiter. Escape erreicht das Terminal immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A shortcut that is off hands its key to the program running in the terminal. Escape always reaches the terminal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un atajo desactivado entrega su tecla al programa que se ejecuta en el terminal. Escape siempre llega al terminal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un raccourci désactivé transmet sa touche au programme exécuté dans le terminal. Échap atteint toujours le terminal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una scorciatoia disattivata passa il suo tasto al programma in esecuzione nel terminale. Esc raggiunge sempre il terminale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無効にしたショートカットのキーは、ターミナルで実行中のプログラムに渡されます。Escape キーは常にターミナルに送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해제된 단축키의 키는 터미널에서 실행 중인 프로그램으로 전달됩니다. Escape 키는 항상 터미널로 전달됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um atalho desativado entrega sua tecla ao programa em execução no terminal. Escape sempre chega ao terminal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключённое сочетание клавиш передаёт свою клавишу программе, запущенной в терминале. Escape всегда передаётся в терминал."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím tắt đã tắt sẽ nhường phím đó cho chương trình đang chạy trong Terminal. Phím Escape luôn được gửi tới Terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭快捷键后，该按键将交由终端中运行的程序处理。Esc 始终会发送到终端。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉快速鍵後，該按鍵將交由終端機中執行的程式處理。Esc 一律會傳送至終端機。"
          }
        }
      }
    },
