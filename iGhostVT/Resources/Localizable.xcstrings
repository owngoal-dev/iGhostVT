          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테마는 Ghostty 테마 카탈로그에서 제공되며 모든 윈도우의 모든 탭에 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os temas vêm do catálogo de temas do Ghostty e se aplicam a todas as abas de todas as janelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Темы берутся из каталога тем Ghostty и применяются ко всем вкладкам во всех окнах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các chủ đề lấy từ thư viện chủ đề của Ghostty và áp dụng cho mọi tab trong mọi cửa sổ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主题来自 Ghostty 主题库，将应用于所有窗口和标签页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主題來自 Ghostty 主題庫，將套用至所有視窗與分頁。"
          }
        }
      }
    },
    "This closes all tabs and stops everything running in them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى إغلاق كل علامات التبويب وإيقاف كل ما يعمل فيها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden alle Tabs geschlossen und alles darin Laufende beendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This closes all tabs and stops everything running in them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto cierra todas las pestañas y detiene todo lo que se ejecuta en ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action ferme tous les onglets et arrête tout ce qui s’y exécute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione chiude tutte le schede e interrompe tutto ciò che vi è in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのタブが閉じられ、その中で実行中のすべてが終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 탭이 닫히고 그 안에서 실행 중인 모든 항목이 종료됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso fecha todas as abas e encerra tudo o que está em execução nelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все вкладки закроются, а всё запущенное в них будет остановлено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ đóng tất cả tab và dừng mọi thứ đang chạy trong đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将关闭所有标签页，并终止其中运行的所有程序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將關閉所有分頁，並終止其中執行的所有程式。"
          }
        }
      }
    },
