    "Unable to connect to the terminal helper. Restart iGhostVT and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الاتصال بمساعد الطرفية. أعد تشغيل iGhostVT وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte keine Verbindung zum Terminal-Helfer hergestellt werden. Starten Sie iGhostVT neu und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
