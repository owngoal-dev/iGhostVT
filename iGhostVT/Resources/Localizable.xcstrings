    "When the command ran in a new shell, leave that shell running instead of ending it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا شُغّل الأمر في صدفة جديدة، أبقِ تلك الصدفة عاملة بدلاً من إنهائها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der Befehl in einer neuen Shell lief, diese Shell weiterlaufen lassen, statt sie zu beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the command ran in a new shell, leave that shell running instead of ending it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el comando se ejecutó en un shell nuevo, deje ese shell en ejecución en lugar de finalizarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la commande s’est exécutée dans un nouveau shell, laisser ce shell en cours au lieu de le terminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il comando è stato eseguito in una nuova shell, lascia quella shell in esecuzione invece di terminarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドを新しいシェルで実行した場合、そのシェルを終了せずに残します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령이 새로운 셸에서 실행된 경우 해당 셸을 종료하지 않고 계속 실행합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o comando for executado em um novo shell, deixe esse shell em execução em vez de encerrá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если команда выполнялась в новой оболочке, оставить её запущенной, а не завершать."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu lệnh đã chạy trong một shell mới, hãy giữ shell đó tiếp tục chạy thay vì kết thúc nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果命令在新 shell 中运行，则保留该 shell 而不结束它。"
