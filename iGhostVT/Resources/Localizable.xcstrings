    "iGhostVT and its terminal helper are different versions. Reinstall iGhostVT to update both." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يختلف إصدار iGhostVT عن إصدار مساعد الطرفية. أعد تثبيت iGhostVT لتحديث كليهما."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT und sein Terminal-Helfer haben unterschiedliche Versionen. Installieren Sie iGhostVT neu, um beide zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT and its terminal helper are different versions. Reinstall iGhostVT to update both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT y su asistente del terminal tienen versiones distintas. Reinstale iGhostVT para actualizar ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT et son assistant du terminal n’ont pas la même version. Réinstallez iGhostVT pour mettre à jour les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT e il suo assistente del terminale hanno versioni diverse. Reinstalla iGhostVT per aggiornare entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT とターミナルヘルパーのバージョンが異なります。iGhostVT を再インストールして、両方を更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT와 터미널 헬퍼의 버전이 다릅니다. iGhostVT를 다시 설치하여 둘 다 업데이트하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iGhostVT e o assistente do terminal estão em versões diferentes. Reinstale o iGhostVT para atualizar os dois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версии iGhostVT и его помощника терминала не совпадают. Переустановите iGhostVT, чтобы обновить обе."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT và Trình trợ giúp Terminal của nó khác phiên bản. Hãy cài đặt lại iGhostVT để cập nhật cả hai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT 与其终端助手版本不一致。请重新安装 iGhostVT 以同时更新两者。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT 與其終端機助手版本不一致。請重新安裝 iGhostVT 以同時更新兩者。"
          }
        }
      }
    },
