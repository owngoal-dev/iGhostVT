    "Returns every terminal session in iGhostVT, whether or not a tab is showing it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد كل جلسة طرفية في iGhostVT، سواء كانت هناك علامة تبويب تعرضها أم لا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt jede Terminalsitzung in iGhostVT zurück, ob ein Tab sie anzeigt oder nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returns every terminal session in iGhostVT, whether or not a tab is showing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve todas las sesiones de terminal de iGhostVT, las muestre una pestaña o no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoie toutes les sessions de terminal d’iGhostVT, qu’un onglet les affiche ou non."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restituisce tutte le sessioni del terminale in iGhostVT, che una scheda le mostri o meno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT のすべてのターミナルセッションを返します。タブに表示されているかどうかは問いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭에 표시되는지 여부와 관계없이 iGhostVT의 모든 터미널 세션을 반환합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retorna todas as sessões de terminal do iGhostVT, estejam ou não sendo mostradas em uma aba."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает все сеансы терминала в iGhostVT, независимо от того, показывает ли их вкладка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả về mọi phiên Terminal trong iGhostVT, bất kể có tab nào hiển thị phiên đó hay không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返回 iGhostVT 中的每个终端会话，无论是否有标签页显示它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回傳 iGhostVT 中的每個終端機工作階段，無論是否有分頁顯示它。"
          }
        }
      }
    },
    "Returns the directory a terminal session's shell is in." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد الدليل الذي توجد فيه صدفة جلسة الطرفية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt das Verzeichnis zurück, in dem sich die Shell einer Terminalsitzung befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returns the directory a terminal session's shell is in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve el directorio en el que está el shell de una sesión de terminal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoie le dossier dans lequel se trouve le shell d’une session de terminal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restituisce la cartella in cui si trova la shell di una sessione del terminale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルセッションのシェルがあるディレクトリを返します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 세션의 셸이 있는 디렉토리를 반환합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retorna o diretório em que está o shell de uma sessão de terminal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает папку, в которой находится оболочка сеанса терминала."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả về thư mục mà shell của phiên Terminal đang ở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返回终端会话的 shell 所在的目录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回傳終端機工作階段的 shell 所在的目錄。"
          }
        }
      }
    },
    "Returns what a terminal session is showing, as plain text. Can also include the session's scrollback." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد ما تعرضه جلسة الطرفية كنص عادي. ويمكن أن يتضمن أيضاً محتوى التمرير للجلسة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt als Text zurück, was eine Terminalsitzung anzeigt. Kann auch den Verlauf der Sitzung einschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returns what a terminal session is showing, as plain text. Can also include the session's scrollback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve lo que muestra una sesión de terminal, como texto sin formato. También puede incluir el historial de desplazamiento de la sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoie ce qu’affiche une session de terminal, en texte brut. Peut aussi inclure l’historique de défilement de la session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restituisce ciò che mostra una sessione del terminale, come testo semplice. Può includere anche la cronologia di scorrimento della sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルセッションの表示内容をプレーンテキストで返します。セッションのスクロールバックを含めることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 세션의 표시 내용을 일반 텍스트로 반환합니다. 세션의 스크롤백도 포함할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retorna o que uma sessão de terminal está mostrando, como texto simples. Também pode incluir o histórico de rolagem da sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает содержимое экрана сеанса терминала как обычный текст. Может также включать историю прокрутки сеанса."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả về nội dung mà phiên Terminal đang hiển thị, dưới dạng văn bản thuần. Cũng có thể kèm lịch sử cuộn của phiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以纯文本返回终端会话正在显示的内容。也可以包含该会话的回滚内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以純文字回傳終端機工作階段正在顯示的內容。也可以包含該工作階段的回捲內容。"
          }
        }
      }
    },
