          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli e disponi i tasti della barra sopra la tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボード上部のショートカットバーに表示するキーと並び順を設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드 위 막대에 표시할 키와 순서를 설정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha e organize as teclas da barra acima do teclado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите и расположите клавиши на панели над клавиатурой."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn và sắp xếp các phím trên thanh phía trên bàn phím."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择并排列键盘上方快捷栏中的按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇並排列鍵盤上方快捷列中的按鍵。"
          }
        }
      }
    },
    "Choose Automatic to use the default login shell. Custom paths must not include the bootstrap root, which can change when the environment is recreated." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر «تلقائي» لاستخدام صدفة تسجيل الدخول الافتراضية. ويجب ألا تتضمن المسارات المخصصة جذر البيئة، فقد يتغير عند إعادة إنشائها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie „Automatisch“, um Ihre Standard-Login-Shell zu verwenden. Benutzerdefinierte Pfade dürfen nicht das Bootstrap-Stammverzeichnis enthalten, das sich ändern kann, wenn die Umgebung neu erstellt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Automatic to use the default login shell. Custom paths must not include the bootstrap root, which can change when the environment is recreated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Automático para usar el shell de inicio de sesión predeterminado. Las rutas personalizadas no deben incluir la raíz del entorno de arranque, que puede cambiar al recrear el entorno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Automatique pour utiliser le shell de connexion par défaut. Les chemins personnalisés ne doivent pas inclure la racine de l’environnement d’amorçage, qui peut changer lorsque l’environnement est recréé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli Automatico per usare la shell di login predefinita. I percorsi personalizzati non devono includere la radice dell’ambiente bootstrap, che può cambiare quando l’ambiente viene ricreato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」を選ぶと、デフォルトのログインシェルを使用します。カスタムパスには、環境の再作成時に変わる可能性があるブートストラップルートを含めないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동을 선택하면 기본 로그인 셸을 사용합니다. 사용자 지정 경로에는 환경을 다시 만들 때 변경될 수 있는 부트스트랩 루트를 포함하지 마십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha Automático para usar o shell de login padrão. Caminhos personalizados não devem incluir a raiz do bootstrap, que pode mudar quando o ambiente for recriado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите «Автоматически», чтобы использовать оболочку входа по умолчанию. Пользовательские пути не должны включать корень загрузочного окружения, который может измениться при пересоздании среды."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn Tự động để dùng shell đăng nhập mặc định. Đường dẫn tùy chỉnh không được chứa thư mục gốc của môi trường, vì thư mục đó có thể thay đổi khi môi trường được tạo lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“自动”以使用默认登录命令行解释器。自定义路径不得包含环境根目录，因为重新创建环境时该目录可能发生变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇「自動」以使用預設登入命令列直譯器。自訂路徑不得包含環境根目錄，因為重新建立環境時該目錄可能會變更。"
          }
        }
      }
    },
    "Choose Automatic to use your login shell. Enter a custom executable path when it is not listed above." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر «تلقائي» لاستخدام صدفة تسجيل الدخول. وأدخل مساراً مخصصاً لملف تنفيذي إذا لم يكن مدرجاً أعلاه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie „Automatisch“, um Ihre Login-Shell zu verwenden. Geben Sie einen benutzerdefinierten Pfad zu einer ausführbaren Datei ein, wenn sie oben nicht aufgeführt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Automatic to use your login shell. Enter a custom executable path when it is not listed above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Automático para usar tu shell de inicio de sesión. Introduce una ruta personalizada a un ejecutable si no aparece arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Automatique pour utiliser votre shell de connexion. Saisissez le chemin personnalisé d’un exécutable s’il ne figure pas ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli Automatico per usare la shell di login. Inserisci il percorso personalizzato di un eseguibile se non è elencato sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」を選ぶと、ログインシェルを使用します。一覧にない場合は、実行可能ファイルのカスタムパスを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동을 선택하면 로그인 셸을 사용합니다. 위 목록에 없으면 실행 파일의 사용자 지정 경로를 입력하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha Automático para usar seu shell de login. Informe um caminho personalizado para um executável se ele não estiver listado acima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите «Автоматически», чтобы использовать оболочку входа. Если нужного исполняемого файла нет в списке выше, укажите путь к нему."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn Tự động để dùng shell đăng nhập của bạn. Nhập đường dẫn tệp thực thi tùy chỉnh nếu nó không có trong danh sách trên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“自动”以使用登录命令行解释器。若未列于上方，请输入可执行文件的自定义路径。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇「自動」以使用登入命令列直譯器。若未列於上方，請輸入可執行檔的自訂路徑。"
          }
        }
      }
    },
