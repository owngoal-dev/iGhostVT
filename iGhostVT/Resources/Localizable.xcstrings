          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kết nối tới Trình trợ giúp Terminal. Hãy khởi động lại iGhostVT rồi thử lại."
          }
        },
        "zh-Hans" : {
