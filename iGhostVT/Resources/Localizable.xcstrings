    "Checks whether a program is running in a terminal session. A session waiting at its shell prompt is not busy." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحقق مما إذا كان هناك برنامج يعمل في جلسة طرفية. الجلسة المنتظرة عند موجّه الصدفة ليست مشغولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft, ob in einer Terminalsitzung ein Programm läuft. Eine Sitzung, die an der Shell-Eingabeaufforderung wartet, ist nicht beschäftigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks whether a program is running in a terminal session. A session waiting at its shell prompt is not busy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba si se está ejecutando un programa en una sesión de terminal. Una sesión que espera en el prompt del shell no está ocupada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie si un programme s’exécute dans une session de terminal. Une session en attente à l’invite du shell n’est pas occupée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla se un programma è in esecuzione in una sessione del terminale. Una sessione in attesa al prompt della shell non è occupata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルセッションでプログラムが実行中かどうかを確認します。シェルのプロンプトで待機中のセッションは使用中ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 세션에서 프로그램이 실행 중인지 확인합니다. 셸 프롬프트에서 대기 중인 세션은 사용 중이 아닙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica se um programa está em execução em uma sessão de terminal. Uma sessão aguardando no prompt do shell não está ocupada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяет, выполняется ли программа в сеансе терминала. Сеанс, ожидающий в приглашении оболочки, не занят."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra xem có chương trình nào đang chạy trong phiên Terminal không. Phiên đang chờ ở dấu nhắc shell thì không bận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查终端会话中是否有程序在运行。在 shell 提示符处等待的会话不算忙碌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查終端機工作階段中是否有程式在執行。在 shell 提示字元處等待的工作階段不算忙碌。"
          }
        }
      }
    },
    "Choose and arrange the keys on the bar above the keyboard." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر المفاتيح ورتّبها في الشريط أعلى لوحة المفاتيح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie die Tasten der Leiste über der Tastatur aus und ordnen Sie sie an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose and arrange the keys on the bar above the keyboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija y ordene las teclas de la barra sobre el teclado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
