    "Ends a terminal session and the program running in it. Any tab showing the session closes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينهي جلسة طرفية والبرنامج العامل فيها. وتُغلق كل علامة تبويب تعرض تلك الجلسة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet eine Terminalsitzung und das darin laufende Programm. Jeder Tab, der die Sitzung anzeigt, wird geschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ends a terminal session and the program running in it. Any tab showing the session closes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finaliza una sesión de terminal y el programa que se ejecuta en ella. Se cierra cualquier pestaña que muestre la sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine une session de terminal et le programme qui s’y exécute. Tout onglet affichant la session se ferme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina una sessione del terminale e il programma in esecuzione al suo interno. Ogni scheda che mostra la sessione si chiude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルセッションと、その中で実行中のプログラムを終了します。そのセッションを表示しているタブはすべて閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 세션과 그 안에서 실행 중인 프로그램을 종료합니다. 해당 세션을 표시하는 탭은 모두 닫힙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerra uma sessão de terminal e o programa em execução nela. Qualquer aba que mostre a sessão é fechada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершает сеанс терминала и запущенную в нём программу. Все вкладки, показывающие этот сеанс, закрываются."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết thúc một phiên Terminal và chương trình đang chạy trong đó. Mọi tab đang hiển thị phiên này sẽ đóng lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结束终端会话及其中运行的程序。显示该会话的标签页都会关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結束終端機工作階段及其中執行的程式。顯示該工作階段的分頁都會關閉。"
          }
        }
      }
    },
