    "Locks or unlocks the tab showing a session. A locked tab ignores your input, and the program keeps running." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقفل علامة التبويب التي تعرض جلسة أو يلغي قفلها. تتجاهل علامة التبويب المقفلة إدخالك، ويستمر البرنامج في العمل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperrt oder entsperrt den Tab, der eine Sitzung anzeigt. Ein gesperrter Tab ignoriert Ihre Eingaben, das Programm läuft weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locks or unlocks the tab showing a session. A locked tab ignores your input, and the program keeps running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea o desbloquea la pestaña que muestra una sesión. Una pestaña bloqueada ignora la entrada de teclado y el programa sigue ejecutándose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouille ou déverrouille l’onglet affichant une session. Un onglet verrouillé ignore vos saisies et le programme continue de s’exécuter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca o sblocca la scheda che mostra una sessione. Una scheda bloccata ignora l’input e il programma resta in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションを表示しているタブをロックまたはロック解除します。ロックされたタブは入力を受け付けませんが、プログラムは実行を続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션을 표시하는 탭을 잠그거나 잠금 해제합니다. 잠긴 탭은 입력을 무시하며 프로그램은 계속 실행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueia ou desbloqueia a aba que mostra uma sessão. Uma aba bloqueada ignora o que você digita e o programa continua em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокирует или разблокирует вкладку, показывающую сеанс. Заблокированная вкладка не принимает ввод, а программа продолжает работать."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa hoặc mở khóa tab đang hiển thị một phiên. Tab đã khóa sẽ bỏ qua thao tác nhập của bạn, còn chương trình vẫn tiếp tục chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定或解锁显示会话的标签页。锁定的标签页会忽略你的输入，程序继续运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎖定或解鎖顯示工作階段的分頁。鎖定的分頁會忽略你的輸入，程式繼續執行。"
          }
        }
      }
    },
