    "Opens iGhostVT and shows a terminal session, in a new tab if no tab is showing it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح iGhostVT ويعرض جلسة طرفية، في علامة تبويب جديدة إذا لم تكن أي علامة تبويب تعرضها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet iGhostVT und zeigt eine Terminalsitzung an – in einem neuen Tab, wenn kein Tab sie anzeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens iGhostVT and shows a terminal session, in a new tab if no tab is showing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre iGhostVT y muestra una sesión de terminal, en una pestaña nueva si ninguna la está mostrando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre iGhostVT et affiche une session de terminal, dans un nouvel onglet si aucun onglet ne l’affiche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre iGhostVT e mostra una sessione del terminale, in una nuova scheda se nessuna scheda la sta mostrando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT を開いてターミナルセッションを表示します。表示しているタブがなければ新規タブで表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT를 열고 터미널 세션을 표시합니다. 표시하는 탭이 없으면 새로운 탭에서 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o iGhostVT e mostra uma sessão de terminal, em uma nova aba se nenhuma aba a estiver mostrando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает iGhostVT и показывает сеанс терминала — в новой вкладке, если ни одна вкладка его не показывает."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở iGhostVT và hiển thị một phiên Terminal, trong tab mới nếu chưa có tab nào hiển thị phiên đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 iGhostVT 并显示终端会话；若没有标签页显示它，则在新标签页中显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟 iGhostVT 並顯示終端機工作階段；若沒有分頁顯示它，則在新分頁中顯示。"
          }
        }
      }
    },
    "Opens iGhostVT with a new tab. The tab runs the program you give, or a shell in the current tab's directory." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح iGhostVT مع علامة تبويب جديدة. تُشغّل علامة التبويب البرنامج الذي تحدده، أو صدفة في دليل علامة التبويب الحالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet iGhostVT mit einem neuen Tab. Der Tab führt das angegebene Programm aus oder eine Shell im Verzeichnis des aktuellen Tabs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens iGhostVT with a new tab. The tab runs the program you give, or a shell in the current tab's directory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre iGhostVT con una pestaña nueva. La pestaña ejecuta el programa que se indique o un shell en el directorio de la pestaña actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre iGhostVT avec un nouvel onglet. L’onglet exécute le programme indiqué, ou un shell dans le dossier de l’onglet actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre iGhostVT con una nuova scheda. La scheda esegue il programma indicato, oppure una shell nella cartella della scheda attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT を開いて新規タブを追加します。タブでは指定したプログラム、または現在のタブのディレクトリでシェルを実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iGhostVT를 열고 새로운 탭을 추가합니다. 탭에서는 지정한 프로그램을 실행하거나 현재 탭의 디렉토리에서 셸을 실행합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o iGhostVT com uma nova aba. A aba executa o programa indicado ou um shell no diretório da aba atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает iGhostVT с новой вкладкой. Во вкладке запускается указанная программа или оболочка в папке текущей вкладки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở iGhostVT với một tab mới. Tab đó chạy chương trình bạn chỉ định, hoặc một shell trong thư mục của tab hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 iGhostVT 并新建标签页。该标签页运行你指定的程序，或在当前标签页的目录中启动 shell。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟 iGhostVT 並新增分頁。該分頁執行你指定的程式，或在目前分頁的目錄中啟動 shell。"
          }
        }
      }
    },
