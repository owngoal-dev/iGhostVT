        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 헬퍼에 연결하지 못했습니다. iGhostVT를 다시 실행한 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
