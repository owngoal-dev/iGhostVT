    "Presses one key in a terminal session — Return, Escape, an arrow, or a control combination such as Control-C." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضغط مفتاحاً واحداً في جلسة طرفية — Return أو Escape أو سهماً أو تركيبة تحكم مثل Control-C."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drückt eine Taste in einer Terminalsitzung – Return, Escape, eine Pfeiltaste oder eine Control-Kombination wie Control-C."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presses one key in a terminal session — Return, Escape, an arrow, or a control combination such as Control-C."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa una tecla en una sesión de terminal: Retorno, Escape, una flecha o una combinación de control como Control-C."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuie sur une touche dans une session de terminal : Retour, Échap, une flèche ou une combinaison de contrôle comme Contrôle-C."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preme un tasto in una sessione del terminale: Invio, Esc, una freccia o una combinazione di controllo come Control-C."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルセッションでキーを1つ押します。Return、Escape、矢印キー、または Control-C などの Control の組み合わせです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 세션에서 키를 하나 누릅니다. Return, Escape, 화살표 키 또는 Control-C 같은 Control 조합입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressiona uma tecla em uma sessão de terminal: Return, Escape, uma seta ou uma combinação de controle como Control-C."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажимает одну клавишу в сеансе терминала: Return, Escape, стрелку или сочетание с Control, например Control-C."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn một phím trong phiên Terminal — Return, Escape, phím mũi tên, hoặc tổ hợp control như Control-C."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在终端会话中按一个键：Return、Escape、方向键，或 Control-C 之类的控制组合键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在終端機工作階段中按一個鍵：Return、Escape、方向鍵，或 Control-C 之類的控制組合鍵。"
          }
        }
      }
    },
