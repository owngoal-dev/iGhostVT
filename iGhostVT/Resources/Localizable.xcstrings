        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O assistente em segundo plano que executa seus terminais está desativado. Ative-o novamente para abrir um terminal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фоновый помощник, который запускает терминалы, выключен. Включите его снова, чтобы открыть терминал."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình trợ giúp chạy nền vốn điều khiển các Terminal của bạn đang tắt. Hãy bật lại để mở Terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
