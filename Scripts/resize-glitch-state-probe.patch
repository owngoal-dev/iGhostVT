@@ -5,6 +5,7 @@
 
 import GameController
 import GhosttyTerminal
+import IOSurface
 import UIKit
 
 /// The app's terminal view: `TerminalView` plus the two locks.
@@ -17,6 +18,53 @@ import UIKit
 /// have to remember. Installed through `TerminalViewState.makePlatformView`
 /// (see `TerminalTab`).
 final class LockableTerminalView: TerminalView {
+    weak var resizeProbeSession: InMemoryTerminalSession?
+    private var resizeProbeLink: CADisplayLink?
+    private var resizeProbeStarted: TimeInterval?
+    private var resizeProbeLastFlush: TimeInterval = 0
+    private var resizeProbeURL: URL?
+    private var resizeProbeRows: [String] = []
+
+    @objc private func sampleResizeProbe(_: CADisplayLink) {
+        guard let started = resizeProbeStarted else { return }
+        let now = Date().timeIntervalSince1970
+        let sublayer = layer.sublayers?.first
+        let surface = sublayer?.contents as? IOSurface
+        let frame = sublayer?.frame ?? .zero
+        let grid = resizeProbeSession?.readViewportText()
+        let gridLines = grid?.split(separator: "\n", omittingEmptySubsequences: false) ?? []
+        let nonblankRows = gridLines.filter { !$0.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty }.count
+        let nonblankBytes = grid?.utf8.filter { $0 != 32 && $0 != 10 && $0 != 13 }.count ?? -1
+        let identity = surface.map { ObjectIdentifier($0).hashValue } ?? 0
+        resizeProbeRows.append([
+            String(format: "%.6f", now),
+            String(format: "%.3f", bounds.width), String(format: "%.3f", bounds.height),
+            String(format: "%.3f", frame.width), String(format: "%.3f", frame.height),
+            String(format: "%.6f", sublayer?.contentsScale ?? 0),
+            sublayer?.contentsGravity.rawValue ?? "none",
+            String(surface?.width ?? 0), String(surface?.height ?? 0),
+            String(surface?.seed ?? 0), String(identity),
+            String(nonblankRows), String(nonblankBytes), grid == nil ? "0" : "1"
+        ].joined(separator: ","))
+        if now - resizeProbeLastFlush >= 1 {
+            flushResizeProbe()
+            resizeProbeLastFlush = now
+        }
+        guard now - started >= 30 else { return }
+        resizeProbeLink?.invalidate()
+        resizeProbeLink = nil
+        flushResizeProbe()
+    }
+
+    private func flushResizeProbe() {
+        guard !resizeProbeRows.isEmpty, let url = resizeProbeURL,
+              let handle = try? FileHandle(forWritingTo: url) else { return }
+        _ = try? handle.seekToEnd()
+        try? handle.write(contentsOf: Data((resizeProbeRows.joined(separator: "\n") + "\n").utf8))
+        try? handle.close()
+        resizeProbeRows.removeAll(keepingCapacity: true)
+    }
+
     /// When true the view refuses every interaction: touches never land
     /// (`hitTest` returns nil) and keyboard focus is refused and released,
     /// which closes the hardware-key path too.
@@ -177,6 +225,26 @@ final class LockableTerminalView: TerminalView {
     /// there is a window it is there to remove.
     override func didMoveToWindow() {
         super.didMoveToWindow()
+        if window != nil, resizeProbeLink == nil, resizeProbeStarted == nil {
+            let now = Date().timeIntervalSince1970
+            resizeProbeStarted = now
+            resizeProbeLastFlush = now
+            let url = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]
+                .appendingPathComponent("resize-state-probe-\(UUID().uuidString).csv")
+            let header = "time,viewWidth,viewHeight,layerWidth,layerHeight,scale,gravity,surfaceWidth,surfaceHeight,surfaceSeed,surfaceIdentity,nonblankRows,nonblankBytes,gridPresent\n"
+            try? header.write(to: url, atomically: true, encoding: .utf8)
+            resizeProbeURL = url
+            AppLog.info(.ghostty, "resize state probe started: \(url.path)")
+            let link = CADisplayLink(target: self, selector: #selector(sampleResizeProbe))
+            link.add(to: .main, forMode: .common)
+            resizeProbeLink = link
+        } else if window == nil {
+            resizeProbeLink?.invalidate()
+            resizeProbeLink = nil
+            flushResizeProbe()
+            resizeProbeStarted = nil
+            resizeProbeURL = nil
+        }
         if !observesHardwareKeyboard {
             observeHardwareKeyboard()
         }
