#!/bin/sh

# Runs only when the package is going away — an upgrade's prerm arrives with
# "upgrade" and must leave everything running for postinst to restart.
if [ "${1:-}" = remove ] || [ "${1:-}" = deconfigure ]; then
    launchctl=@PREFIX@/usr/bin/launchctl
    [ -x "$launchctl" ] || launchctl=/bin/launchctl
    killall=@PREFIX@/usr/bin/killall
    [ -x "$killall" ] || killall=/usr/bin/killall

    # The app first: it is about to lose its daemon and its own binary.
    if [ -x "$killall" ]; then
        "$killall" -9 iGhostVT 2>/dev/null || true
    fi

    if [ -x "$launchctl" ]; then
        "$launchctl" bootout system/wiki.qaq.ighostvtd 2>/dev/null || true
        "$launchctl" bootout user/501/wiki.qaq.ighostvtd 2>/dev/null || true
        "$launchctl" bootout gui/501/wiki.qaq.ighostvtd 2>/dev/null || true
    fi

    # bootout kills the daemon but not the shells it spawned; they are
    # orphaned children holding PTYs that no longer lead anywhere.
    if [ -x "$killall" ]; then
        "$killall" -9 ighostvtd 2>/dev/null || true
        "$killall" -9 ighostvtd-io 2>/dev/null || true
    fi
fi

exit 0
