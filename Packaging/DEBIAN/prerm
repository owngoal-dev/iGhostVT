#!/bin/sh

find_tool() {
    for candidate in "@PREFIX@/usr/bin/$1" "/usr/bin/$1" "/bin/$1"; do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

# Named once, alone on its line: see postinst for why the id never sits next
# to a redirect.
label=wiki.qaq.ighostvtd

# Runs only when the package is going away — an upgrade's prerm arrives with
# "upgrade" and must leave everything running for postinst to restart.
if [ "${1:-}" = remove ] || [ "${1:-}" = deconfigure ]; then
    killall="$(find_tool killall)" || killall=

    # The app first: it is about to lose its daemon and its own binary.
    if [ -n "$killall" ]; then
        "$killall" -9 iGhostVT 2>/dev/null || true
    fi

    if launchctl="$(find_tool launchctl)"; then
        "$launchctl" bootout "system/$label" 2>/dev/null || true
        "$launchctl" bootout "user/501/$label" 2>/dev/null || true
        "$launchctl" bootout "gui/501/$label" 2>/dev/null || true
    fi

    # bootout kills the daemon but not the shells it spawned; they are
    # orphaned children holding PTYs that no longer lead anywhere.
    if [ -n "$killall" ]; then
        "$killall" -9 ighostvtd 2>/dev/null || true
        "$killall" -9 ighostvtd-io 2>/dev/null || true
    fi
fi

exit 0
