#!/bin/sh

find_tool() {
    for candidate in "@PREFIX@/usr/bin/$1" "/usr/bin/$1" "/bin/$1"; do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

# Named once, alone on its line: see postinst for why the id never sits next
# to a redirect.
label=wiki.qaq.ighostvtd

# Belt over prerm's braces: dpkg runs postrm even when prerm was skipped or
# failed (--force-remove, a broken earlier state), so everything here has to
# be safe to repeat and safe when nothing is left to clean.
if [ "${1:-}" = remove ] || [ "${1:-}" = purge ]; then
    if launchctl="$(find_tool launchctl)"; then
        "$launchctl" bootout "system/$label" 2>/dev/null || true
        "$launchctl" bootout "user/501/$label" 2>/dev/null || true
        "$launchctl" bootout "gui/501/$label" 2>/dev/null || true
    fi

    if killall="$(find_tool killall)"; then
        "$killall" -9 iGhostVT 2>/dev/null || true
        "$killall" -9 ighostvtd 2>/dev/null || true
        "$killall" -9 ighostvtd-io 2>/dev/null || true
    fi
fi

exit 0
