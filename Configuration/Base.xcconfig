#include "Version.xcconfig"

// Optional DEVELOPMENT_TEAM / CODE_SIGN_STYLE live in the git-ignored
// Developer*.xcconfig overlays. See Developer.xcconfig.example.
//
// Device packages from `make deb` override signing on the xcodebuild command
// line; Scripts/package-deb.sh ad-hoc signs with ldid. The Mac Catalyst
// development build (`make mac-run`) does the same with codesign.

// visionOS. The app and the daemon build for xros (a jailbroken Vision Pro is
// the same product as a jailbroken iPad: the app renders, ighostvtd owns the
// shells). 1.0 is the lowest the SDK offers and what libghostty-spm declares;
// the visionOS section of AGENTS.md lists the one construct that would raise
// it (a multi-child `#available` branch, whose TupleContent is visionOS 26+).
XROS_DEPLOYMENT_TARGET = 1.0

// The `CiGhostVTXPC` clang module — static inline accessors over the SDK's
// XPC_TYPE_* macros. Naming those macros in Swift instead resolves to the iOS
// 27 SDK's XPC overlay and links /usr/lib/swift/libswiftXPC.dylib non-weakly,
// which does not exist on iOS 15. See Shared/XPCShim/module.modulemap.
SWIFT_INCLUDE_PATHS = $(inherited) $(SRCROOT)/Shared/XPCShim
